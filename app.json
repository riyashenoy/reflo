{
  "expo": {
    "name": "reflo",
    "slug": "reflo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Reflo needs camera access for motion capture during pilates workouts.",
        "NSMicrophoneUsageDescription": "Reflo needs microphone access for voice cues and workout audio.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "webpack",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Reflo needs camera access for motion capture during pilates workouts.",
          "microphonePermission": "Reflo needs microphone access for voice cues and workout audio.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}
